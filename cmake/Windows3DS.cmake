set(CMAKE_SYSTEM_NAME Nintendo3DS)
set(CMAKE_SYSTEM_PROCESSOR armv6k)
set(DEVKITPRO "$ENV{DEVKITPRO}")
set(DEVKITARM "$ENV{DEVKITARM}")
list(APPEND CMAKE_MODULE_PATH "${DEVKITPRO}/cmake")
foreach(pair "C_COMPILER;gcc" "CXX_COMPILER;g++" "ASM_COMPILER;gcc" "AR;gcc-ar" "RANLIB;gcc-ranlib" "LINKER;ld" "STRIP;strip")
  list(GET pair 0 var)
  list(GET pair 1 bin)
  set(CMAKE_${var} "${DEVKITARM}/bin/arm-none-eabi-${bin}.exe")
endforeach()
set(DKP_OBJCOPY "${DEVKITARM}/bin/arm-none-eabi-objcopy.exe")
set(DKP_NM "${DEVKITARM}/bin/arm-none-eabi-nm.exe")
set(DKP_BIN2S "${DEVKITPRO}/tools/bin/bin2s.exe")
set(CMAKE_USER_MAKE_RULES_OVERRIDE "${DEVKITPRO}/cmake/dkp-rule-overrides.cmake")
include("${DEVKITPRO}/cmake/dkp-toolchain-common.cmake")
__dkp_toolchain(devkitARM armv6k arm-none-eabi)
set(CTR_ROOT "${DEVKITPRO}/libctru")
set(DKP_INSTALL_PREFIX_INIT "${DEVKITPRO}/portlibs/3ds")
__dkp_platform_prefix("${DEVKITPRO}/portlibs/3ds" "${CTR_ROOT}")
set(CTR_SMDHTOOL_EXE "${DEVKITPRO}/tools/bin/smdhtool.exe")
set(CTR_3DSXTOOL_EXE "${DEVKITPRO}/tools/bin/3dsxtool.exe")
set(CTR_PICASSO_EXE "${DEVKITPRO}/tools/bin/picasso.exe")
set(CTR_DEFAULT_ICON "${CTR_ROOT}/default_icon.png")
